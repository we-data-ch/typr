#! pkg: base
#! tier: T1
#! ret: current working directory path
#! example: getwd()   # -> "/home/user"
# File System management ----------

@getwd: () -> char;

#! pkg: base
#! tier: T1
#! param path: directory path to set as working directory
#! ret: previous working directory
#! example: setwd("/tmp")
@setwd: (path: char) -> char;

#! pkg: base
#! tier: T1
#! ret: vector of files in current directory
#! example: dir()
@dir: () -> [#N, char];

#! pkg: base
#! tier: T1
#! ret: vector of files in current directory
#! example: list__files()
@list__files: () -> [#N, char];

#! pkg: base
#! tier: T1
#! param file: file path to check
#! ret: TRUE if file exists
#! example: file__exists("README.md")   # -> TRUE
@file__exists: (file: char) -> bool;

#! pkg: base
#! tier: T1
#! param file: file path to create
#! ret: TRUE if successful
#! note: creates empty file
@file__create: (file: char) -> bool;

#! pkg: base
#! tier: T1
#! param file: file path to remove
#! ret: TRUE if successful
#! note: deletes the file
@file__remove: (file: char) -> bool;

#! pkg: base
#! tier: T1
#! param old: current file path
#! param new: new file path
#! ret: TRUE if successful
#! example: file__rename("old.txt", "new.txt")
@file__rename: (old: char, new: char) -> bool;

#! pkg: base
#! tier: T1
#! param source: source file path
#! param dest: destination file path
#! ret: TRUE if successful
#! example: file__copy("a.txt", "b.txt")
@file__copy: (source: char, dest: char) -> bool;

#! pkg: base
#! tier: T1
#! param source: source path
#! param dest: destination path
#! ret: TRUE if successful
#! note: creates directory
@dir__create: (source: char, dest: char) -> bool;

#! pkg: base
#! tier: T1
#! param target: file path to delete
#! ret: TRUE if successful
#! note: alias for file.remove
@unlink: (target: char) -> bool;


# --------------------------------
