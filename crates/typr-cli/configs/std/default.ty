#! pkg: base
#! tier: T1
#! param file: R source file path
#! ret: invisibly NULL
#! note: executes R code in current environment
#! example: source("utils.R")
@source: (char) -> Empty;

#! pkg: base
#! tier: T1
#! param a: value to coerce
#! ret: character representation
#! coercion: any type -> character (R as.character)
#! example: as__character(42)   # -> "42"
@as__character: (a: A) -> char;

#! pkg: base
#! tier: T1
#! param a: input vector
#! ret: same vector unchanged
#! note: identity for arrays; other types implement via S3 dispatch
#! example: as_vec(c(1,2,3))   # -> c(1,2,3)
@as_vec: (a: [#N, T]) -> [#N, T];

#! pkg: base
#! tier: T1
#! param a: input vector
#! param f: transformation function (T) -> U
#! ret: transformed vector with same length
#! example: map(c(1,2,3), add(1))   # -> c(2,3,4)
@map: (a: [#N, T], f: (T) -> U) -> [#N, U];

#! pkg: base
#! tier: T1
#! param a: input vector
#! param f: predicate function (T) -> bool
#! ret: elements where predicate is TRUE
#! note: result length <= input length
#! example: filter(c(1,2,3,4), is_even)   # -> c(2,4)
@filter: (a: [#N, T], f: (T) -> bool) -> [#N, T];

#! pkg: base
#! tier: T1
#! param a: input vector
#! param i: 1-based index
#! param val: new value
#! ret: new vector with element at i replaced
#! note: returns new vector (immutable update)
#! example: set_at(c(1,2,3), 2, 99)   # -> c(1,99,3)
@set_at: (a: [#N, T], i: int, val: T) -> [#N, T];

#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: integer sum
#! example: 1L + 2L   # -> 3L
@add: (a: int, b: int) -> int;
#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: numeric sum
#! example: 1.5 + 2.5   # -> 4
@add: (a: num, b: num) -> num;

#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: integer difference
#! example: 5L - 3L   # -> 2L
@minus: (a: int, b: int) -> int;
#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: numeric difference
#! example: 5.0 - 3.0   # -> 2
@minus: (a: num, b: num) -> num;

#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: integer product
#! example: 3L * 4L   # -> 12L
@mul: (a: int, b: int) -> int;
#! pkg: base
#! tier: T1
#! param a: left operand
#! param b: right operand
#! ret: numeric product
#! example: 3.0 * 4.0   # -> 12
@mul: (a: num, b: num) -> num;

#! pkg: base
#! tier: T1
#! param a: dividend
#! param b: divisor
#! ret: integer quotient
#! example: 10L / 3L   # -> 3L
@div: (a: int, b: int) -> int;
#! pkg: base
#! tier: T1
#! param a: dividend
#! param b: divisor
#! ret: numeric quotient
#! example: 10.0 / 3.0   # -> 3.333...
@div: (a: num, b: num) -> num;

#! pkg: base
#! tier: T1
#! param a: object to subset
#! param b: field/index name
#! ret: extracted value
#! note: equivalent to R's $ or [[ operator
#! example: get(list(x=1), "x")   # -> 1
@get: (a: Any, b: char) -> T;

#! pkg: base
#! tier: T1
#! param a: start value
#! param b: end value
#! param c: step size
#! ret: integer sequence from a to b by c
#! example: seq(1L, 5L, 1L)   # -> c(1,2,3,4,5)
@seq: (a: #I, b: #J, c: #K) -> Vec[#J-#I/#K+1, int];

#! pkg: base
#! tier: T1
#! param a: character vector to join
#! param s: separator string
#! ret: single concatenated string
#! example: join(c("a","b","c"), ",")   # -> "a,b,c"
@join: (a: [#N, char], s: char) -> char;

#! pkg: base
#! tier: T1
#! param a: string to check
#! param b: prefix to test
#! ret: TRUE if a starts with b
#! example: startsWith("hello", "hel")   # -> TRUE
@startsWith: (a: char, b: char) -> bool;

#! pkg: base
#! tier: T1
#! param a: string to check
#! param b: suffix to test
#! ret: TRUE if a ends with b
#! example: endsWith("hello", "llo")   # -> TRUE
@endsWith: (a: char, b: char) -> bool;

#! pkg: base
#! tier: T1
#! param a: substring to find
#! param b: string to search in
#! ret: TRUE if a is found in b
#! example: contains("hello", "ell")   # -> TRUE
@contains: (a: char, b: char) -> bool;
