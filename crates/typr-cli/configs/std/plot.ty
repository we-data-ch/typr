#! pkg: graphics
#! tier: T2
#! param a: x-axis values
#! param b: y-axis values
#! param c: plot type ("p", "l", "b", "c", "o", "h", "s")
#! param xlim: x-axis limits [min, max]
#! param ylim: y-axis limits [min, max]
#! param log: logarithmic axis ("", "x", "y", "xy")
#! param main: main title
#! param sub: subtitle
#! param xlab: x-axis label
#! param ylab: y-axis label
#! param ann: annotate axis (TRUE/FALSE)
#! param axes: draw axes (TRUE/FALSE)
#! ret: NULL (invisibly) — opens graphics device
#! note: side-effectful; renders plot to active device
#! example: plot(c(1,2,3), c(4,5,6), "p", main="My Plot")
# PLOT FUNCTION ----------
@plot: (a: [#N, num], b: [#N, num], c: char, xlim: [2, num], ylim: [2, num], log: char, main: char, sub: char, xlab: char, ylab: char, ann: bool, axes: bool) -> .None;

        type Plot = record{ x: [#N, num], y: [#N, num], kind: char, xlim: [2, num], ylim: [2, num], log: char, main: char, sub: char, xlab: char, ylab: char, ann: bool, axes: bool};

#! pkg: graphics
#! tier: T1
#! ret: default Plot record with sensible defaults
let bplot: Plot <- :{ x: [0.5], y: [0.5], kind: "p", xlim: [0.0, 5.0], ylim: [0.0, 5.0], log: "", main: "", sub: "", xlab: "", ylab: "", ann: true, axes: true};
};

#! pkg: graphics
#! tier: T2
#! param p: Plot record to display
#! ret: NULL (invisibly) — renders the plot
#! note: side-effectful; calls plot() with record fields
let show <- fn(p: Plot): .None;
	plot(p.x, p.y, p.kind, p.xlim, p.ylim, p.log, p.main, p.sub, p.xlab, p.ylab, p.ann, p.axes)
};
#---------------------
