#! pkg: base
#! tier: T2
#! param msg: error message
#! ret: never returns (stops execution)
#! note: throws an R error condition
#! example: stop("something went wrong")
# ERROR HANDLING ----------
@stop: (msg: char) -> Empty;

# OPTION TYPE -------------
type Option<T> = .Some(T) | .None;

#! pkg: base
#! tier: T1
#! param value: Option to unwrap
#! ret: inner value if Some, stops with error if None
#! note: panics on None — use unwrap_or for safe default
let unwrap <- fn(value: Option<T>): T {
	match value {
		.Some(v)	=> v,
		.None => stop("The value is not unwrappable.")
	}
};

#! pkg: base
#! tier: T1
#! param value: Option to unwrap
#! param msg: error message if None
#! ret: inner value if Some, stops with msg if None
let expect <- fn(value: Option<T>, msg: char): T {
	match value {
		.Some(v)	=> v,
		.None => stop(msg)
	}
};


#! pkg: base
#! tier: T1
#! param value: Option to unwrap
#! param alternative: default value if None
#! ret: inner value if Some, alternative if None
#! example: unwrap_or(None, 0)   # -> 0
let unwrap_or <- fn(value: Option<T>, alternative: T): T {
	match value {
		.Some(v) => v,
		.None => alternative
	}
};

#! pkg: base
#! tier: T1
#! param value: Option to check
#! ret: TRUE if Some
let is_some <- fn(value: Option<T>): bool {
	match value {
		.Some(v) => true,
		.None => false
	}
};

#! pkg: base
#! tier: T1
#! param value: Option to check
#! ret: TRUE if None
let is_none <- fn(value: Option<T>): bool {
	match value {
		.Some(v) => false,
		.None => true
	}
};

#! pkg: base
#! tier: T1
#! param a: R value (NULL or non-NULL)
#! ret: Option wrapping the value
#! coercion: NULL -> .None, non-NULL -> .Some(value)
#! note: bridge for @extern interop with nullable R APIs
@from_nullable: (Any) -> Option<Any>;
#! pkg: base
#! tier: T1
#! param a: Option value
#! ret: R value (NULL for .None, inner for .Some)
#! coercion: .None -> NULL, .Some(v) -> v
#! note: bridge for @extern interop with nullable R APIs
@to_nullable: (Option<T>) -> Any;
