# An integer literal outside the 32-bit range is a double in R, so it must
# type as `num` instead of aborting the compiler.
let above_max: num <- 2147483648;
let below_min: num <- -2147483649;
let large: num <- 99999999999;
let large_fraction: num <- 99999999999.5;
let still_int: int <- 2147483647;
